rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMasterManager() {
      return isAuthenticated() && request.auth.token.email == 'twindsheimer91@gmail.com';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isMasterManager();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isMasterManager());
      allow update: if isOwner(userId) || isMasterManager();
      allow delete: if isMasterManager();

      // Test Submissions subcollection
      match /tests/{testId} {
        allow read, write: if isOwner(userId) || isMasterManager();
      }
    }

    // Guest / Comparison Subjects
    match /guestSubjects/{subjectId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isMasterManager();
    }

    // Community Forum Sanctuary Posts
    match /communityPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isMasterManager());
      allow delete: if isMasterManager() || (resource.data.authorId == request.auth.uid);
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
